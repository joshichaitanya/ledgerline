{
  "name": "create-transaction-service",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:up": "node-pg-migrate up --migrations-table event_store_migrations",
    "migrate:down": "node-pg-migrate down --migrations-table event_store_migrations",
    "partitions:manage": "ts-node src/scripts/manage-partitions.ts",
    "partitions:manage:built": "node dist/scripts/manage-partitions.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@scalable-demo/toolkit": "file:../toolkit",
    "express": "^4.19.2",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
