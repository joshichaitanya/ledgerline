{
  "name": "db-writer-service",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "migrate:transactions:up": "node-pg-migrate up -m migrations/transactions --migrations-table transactions_migrations",
    "migrate:transactions:down": "node-pg-migrate down -m migrations/transactions --migrations-table transactions_migrations"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
